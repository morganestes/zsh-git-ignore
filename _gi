################################################################################

#######################################
# Completion function for gitignore (gi / zshgi).
# Handles completion for options and cached gitignore.io templates.
# Globals:
#   HOME
#   XDG_CACHE_HOME
#   ZSHGI_DEBUG
# Arguments:
#   Command line words to complete.
# Returns:
#   0 if completions were added, non-zero otherwise.
#######################################
_gi() {
	emulate -L zsh
	setopt extended_glob

	((ZSHGI_DEBUG)) && setopt LOCAL_OPTIONS WARN_CREATE_GLOBAL

	local curcontext="$curcontext" state line

	_arguments -C \
		'(-h --help)'{-h,--help}'[show help message]' \
		'(-l --list)'{-l,--list}'[list available templates]' \
		'(-v --verbose)'{-v,--verbose}'[show detailed run messages]' \
		'(-n --dry-run)'{-n,--dry-run}'[display output without writing to file]' \
		'--overwrite[overwrite existing file instead of appending]' \
		'(-o --output)'{-o,--output}'[specify path to output file]:output file:_files' \
		'*: :->templates' && return 0

	case "$state" in
	templates)
		local templates
		templates=$(_zshgi_get_templates | sed '/^$/d')
		templates=(${(f)templates})

		# Remove matched part from completion (keep already typed templates)
		compset -P '*,'

		local -a expl
		_wanted templates expl 'gitignore template' compadd -q -S ',' -a templates
		;;
	esac
}

_gi "$@"

